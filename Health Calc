def Status(height, weight, age) :

    print("====Health Status Calculator====")
    print()
    weight_Kg = weight * 0.453592
    BMI = weight_Kg / height ** 2
    print(f"Height: {height:.2f}")
    print()

    print(f"Weight: {weight:.0f}")
    print()

    print(f"Age: {age:.0f}")
    print()

    print(f"BMI: {BMI:.2f}")
    print()

    print(f"Weight in kg: {weight_Kg:.2f}")
    print()

    if age > 18:
        print ("Age Status: Adult")
    elif age == 18:
        print ("Age Status: Just Turned Adult")
    else:
        print ("Age Status: Minor")
        print()
    
    if BMI < 18.5:
        print ("BMI Status: Underweight")
    elif BMI < 25:
        print ("BMI Status: Healthy")
        print()
    elif BMI < 30: 
        print ("BMI Status: Overweight")
        print()
    else:
        print ("BMI Status: Obese")
        print()

feet = int(input("Enter Height (feet): "))
inches =  int(input("Enter Hight (inches): "))
height = (feet * 12 + inches) * 0.0254
weight = float(input("Enter Weight Here:"))
age = int(input("Enter Age Here:"))

Status(height,weight,age)
